// ─────────────────────────────────────────────────────────────────────────────
//  crm.factory — database schema
//
//  Multi-tenant SaaS CRM. Кожна бізнес-сутність прив'язана до `organizationId`
//  і НІКОЛИ не читається без tenant-фільтра (див. src/lib/db/tenant.ts).
//
//  Гроші зберігаються в мінорних одиницях (центах) як Int — жодних проблем
//  з float-арифметикою та серіалізацією Decimal у React Server Components.
//  Час зберігається в UTC; відображення — у таймзоні організації.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  /// Пряме підключення для міграцій, в обхід пулера.
  ///
  /// Neon (і Supabase) дають дві адреси на ту саму базу: через пулер —
  /// з `-pooler` у хості — і пряму. Застосунку потрібен саме пулер:
  /// кожен серверлес-виклик відкриває з'єднання, і без пулера база
  /// швидко впирається в ліміт.
  ///
  /// Але пулер працює в transaction-режимі й не пропускає частину DDL —
  /// саме на цьому мовчки зупинявся `prisma migrate deploy`. Тож запити
  /// йдуть через `url`, а міграції — через `directUrl`.
  ///
  /// Локально пулера немає, тож обидві змінні там просто однакові.
  directUrl = env("DIRECT_URL")
}

// ─── Ідентичність та доступ ──────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  phone        String?
  locale       String    @default("uk")
  isSuperAdmin Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships         Membership[]
  sessions            Session[]
  passwordResets      PasswordResetToken[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  clientNotes         ClientNote[]
  createdAppointments Appointment[]  @relation("AppointmentCreatedBy")

  @@index([email])
}

/// Серверна сесія з можливістю відкликання. У cookie лежить підписаний JWT,
/// але кожен запит перевіряє, що сесія ще жива в БД.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Одноразовий токен відновлення пароля.
/// У базі лежить лише SHA-256 хеш — навіть маючи дамп БД, відновити
/// посилання неможливо. Токен живе 60 хвилин і згорає після використання.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// Зв'язок користувача з організацією + його роль у ній.
/// Саме цей запис — джерело істини для tenant-ізоляції та permissions.
model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           Role             @default(EMPLOYEE)
  status         MembershipStatus @default(ACTIVE)
  employeeId     String?          @unique
  invitedEmail   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  overrides    PermissionOverride[]

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// Точкове розширення/звуження прав понад базову роль.
/// Backend перевіряє ці записи разом із матрицею ролей.
model PermissionOverride {
  id           String  @id @default(cuid())
  membershipId String
  permission   String
  allowed      Boolean

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, permission])
}

// ─── Організація (tenant) ────────────────────────────────────────────────────

model Organization {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  industry   String?
  phone      String?
  email      String?
  address    String?
  about      String?
  logoUrl    String?
  coverUrl   String?
  brandColor String  @default("#2563EB")
  timezone   String  @default("Europe/Kyiv")
  currency   String  @default("EUR")
  locale     String  @default("uk")

  onboardingStep      Int     @default(0)
  onboardingCompleted Boolean @default(false)

  // Налаштування онлайн-запису
  bookingEnabled      Boolean @default(true)
  bookingAutoConfirm  Boolean @default(true)
  bookingLeadTimeMin  Int     @default(120)
  bookingHorizonDays  Int     @default(60)
  bookingCancelHours  Int     @default(12)
  bookingSlotStepMin  Int     @default(15)
  bookingWelcomeText  String?
  bookingRequireEmail Boolean @default(false)

  // Посилання для клієнтів на публічній сторінці
  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?
  mapsUrl      String?

  // Налаштування нагадувань (канали — під майбутні інтеграції)
  // Відгуки
  reviewsEnabled   Boolean @default(true)
  /// Через скільки годин після візиту питати враження.
  reviewDelayHours Int     @default(4)
  /// Куди вести тих, хто готовий написати публічно (Google Maps тощо).
  reviewPublicUrl  String?

  reminderEnabled     Boolean @default(true)
  reminderHoursBefore Int     @default(24)
  reminderChannels    String  @default("IN_APP")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  employees      Employee[]
  clients        Client[]
  services       Service[]
  categories     ServiceCategory[]
  appointments   Appointment[]
  payments       Payment[]
  leads          Lead[]
  pipelineStages PipelineStage[]
  notifications  Notification[]
  businessHours  BusinessHours[]
  reminders      ReminderJob[]
  auditLogs      AuditLog[]
  reviews        Review[]
  media          MediaAsset[]
  automations    Automation[]
  automationRuns AutomationRun[]
  subscription   Subscription?

  @@index([slug])
}

// ─── Медіа ───────────────────────────────────────────────────────────────────

/// Куди прикріплене зображення.
enum MediaKind {
  GALLERY
  LOGO
  COVER
  EMPLOYEE
}

/// Зображення, завантажені салоном: інтер'єр, роботи, фото майстрів.
///
/// Байти лежать у Postgres, а не в зовнішньому сховищі. Це свідомий вибір
/// для цього етапу: салону вистачає десятка фото, а нульова конфігурація
/// важливіша за ідеальну архітектуру — жодних ключів, бакетів і CORS.
/// Файли стискаються в браузері до ~200 КБ, тож рядок лишається невеликим.
/// Перехід на Vercel Blob чи S3 зачепить лише `src/server/media.ts`.
///
/// ВАЖЛИВО: `data` ніколи не вибирається у списках — тільки в роздачі
/// одного файла. Інакше кожен рендер сторінки тягнув би мегабайти.
model MediaAsset {
  id             String    @id @default(cuid())
  organizationId String
  kind           MediaKind @default(GALLERY)
  data           Bytes
  mimeType       String
  width          Int
  height         Int
  sizeBytes      Int
  caption        String?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, sortOrder])
}

// ─── Автоматизації ───────────────────────────────────────────────────────────

/// Подія, на яку спрацьовує правило.
enum AutomationTrigger {
  APPOINTMENT_CREATED
  APPOINTMENT_COMPLETED
  APPOINTMENT_CANCELLED
  APPOINTMENT_NO_SHOW
  CLIENT_CREATED
}

enum AutomationRunStatus {
  MATCHED
  SKIPPED
  FAILED
}

/// Правило «Коли → Якщо → Тоді».
///
/// Умови й дії лежать у JSON, а не окремими таблицями: набір полів у них
/// різний для кожного типу, і нормалізувати це означало б завести
/// таблицю з колонкою `value String` — тобто той самий JSON, лише
/// повільніший. Форма перевіряється схемою Zod на вході (lib/automation.ts),
/// тож у базу неможливо покласти правило, яке рушій не зрозуміє.
model Automation {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  trigger        AutomationTrigger
  /// Умови, які МАЮТЬ виконатись усі разом.
  conditions     Json              @default("[]")
  /// Дії, що виконуються по черзі.
  actions        Json              @default("[]")
  isActive       Boolean           @default(true)
  runCount       Int               @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([organizationId, trigger, isActive])
}

/// Журнал спрацювань — без нього автоматизація виглядає як магія,
/// про яку неможливо сказати, працює вона чи ні.
model AutomationRun {
  id             String              @id @default(cuid())
  automationId   String
  organizationId String
  status         AutomationRunStatus
  entityType     String?
  entityId       String?
  /// Що саме сталося: які дії виконано або чому пропущено.
  detail         String?
  createdAt      DateTime            @default(now())

  automation   Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([automationId, createdAt])
  @@index([organizationId, createdAt])
}

// ─── Тарифи та підписка ──────────────────────────────────────────────────────

enum Plan {
  FREE
  STARTER
  BUSINESS
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// Підготовлено під Stripe: externalCustomerId / externalSubscriptionId
/// заповнюються провайдером, решта логіки від провайдера не залежить.
model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  plan                   Plan               @default(FREE)
  status                 SubscriptionStatus @default(TRIALING)
  seats                  Int                @default(3)
  priceCents             Int                @default(0)
  currency               String             @default("EUR")
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  externalCustomerId     String?
  externalSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Робочі години самого бізнесу (0 = неділя ... 6 = субота).
model BusinessHours {
  id             String  @id @default(cuid())
  organizationId String
  weekday        Int
  openMinute     Int     @default(540)
  closeMinute    Int     @default(1080)
  isClosed       Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, weekday])
}

// ─── Команда ─────────────────────────────────────────────────────────────────

model Employee {
  id                   String    @id @default(cuid())
  organizationId       String
  name                 String
  position             String?
  email                String?
  phone                String?
  avatarUrl            String?
  color                String    @default("#2563EB")
  bio                  String?
  isActive             Boolean   @default(true)
  acceptsOnlineBooking Boolean   @default(true)
  hiredAt              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership?
  schedules    EmployeeSchedule[]
  exceptions   ScheduleException[]
  services     EmployeeService[]
  appointments Appointment[]
  reviews      Review[]
  payments     Payment[]
  leads        Lead[]

  @@index([organizationId])
  @@index([organizationId, isActive])
}

/// Тижневий графік. Хвилини від опівночі: 540 = 09:00, 1080 = 18:00.
model EmployeeSchedule {
  id          String  @id @default(cuid())
  employeeId  String
  weekday     Int
  startMinute Int     @default(540)
  endMinute   Int     @default(1080)
  breakStart  Int?
  breakEnd    Int?
  isDayOff    Boolean @default(false)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, weekday])
}

enum ExceptionType {
  DAY_OFF
  VACATION
  SICK_LEAVE
  CUSTOM_HOURS
}

/// Винятки з графіка: відпустка, вихідний, спеціальні години на конкретну дату.
model ScheduleException {
  id          String        @id @default(cuid())
  employeeId  String
  date        DateTime      @db.Date
  endDate     DateTime?     @db.Date
  type        ExceptionType @default(DAY_OFF)
  startMinute Int?
  endMinute   Int?
  note        String?
  createdAt   DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
}

// ─── Послуги ─────────────────────────────────────────────────────────────────

model ServiceCategory {
  id             String @id @default(cuid())
  organizationId String
  name           String
  color          String @default("#2563EB")
  sortOrder      Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services     Service[]

  @@index([organizationId])
}

model Service {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String?
  name           String
  description    String?
  durationMin    Int      @default(60)
  bufferMin      Int      @default(0)
  priceCents     Int      @default(0)
  color          String   @default("#2563EB")
  isActive       Boolean  @default(true)
  onlineBooking  Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ServiceCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  employees    EmployeeService[]
  appointments Appointment[]
  leads        Lead[]

  @@index([organizationId])
  @@index([organizationId, isActive])
}

/// Хто яку послугу виконує (+ персональна ціна / тривалість).
model EmployeeService {
  id                 String @id @default(cuid())
  employeeId         String
  serviceId          String
  priceCentsOverride Int?
  durationOverride   Int?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceId])
  @@index([serviceId])
}

// ─── Клієнти ─────────────────────────────────────────────────────────────────

enum ClientStatus {
  NEW
  ACTIVE
  VIP
  INACTIVE
  BLOCKED
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String?
  phone          String?
  email          String?
  status         ClientStatus @default(NEW)
  source         String?
  birthday       DateTime?    @db.Date
  address        String?
  tags           String[]     @default([])
  marketingOptIn Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  payments     Payment[]
  notes        ClientNote[]
  reviews      Review[]
  leads        Lead[]

  @@index([organizationId])
  @@index([organizationId, phone])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

/// Внутрішні нотатки менеджера — клієнт їх не бачить.
model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  authorId  String?
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

// ─── Записи ──────────────────────────────────────────────────────────────────

enum AppointmentStatus {
  WAITING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  CRM
  ONLINE
  IMPORT
}

model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  clientId       String
  serviceId      String
  employeeId     String
  startAt        DateTime
  endAt          DateTime
  status         AppointmentStatus @default(CONFIRMED)
  source         AppointmentSource @default(CRM)
  priceCents     Int               @default(0)
  note           String?
  internalNote   String?
  createdById    String?
  cancelledAt    DateTime?
  cancelReason   String?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments     Payment[]
  reminders    ReminderJob[]
  reviews      Review[]

  @@index([organizationId, startAt])
  @@index([organizationId, status])
  @@index([employeeId, startAt])
  @@index([clientId, startAt])
}

// ─── Продажі ─────────────────────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  TRANSFER
  CERTIFICATE
}

enum PaymentStatus {
  PAID
  PENDING
  REFUNDED
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  appointmentId  String?
  clientId       String?
  employeeId     String?
  amountCents    Int
  currency       String        @default("EUR")
  method         PaymentMethod @default(CASH)
  status         PaymentStatus @default(PAID)
  paidAt         DateTime      @default(now())
  note           String?
  externalId     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([organizationId, paidAt])
  @@index([organizationId, status])
}

// ─── Воронка продажів ────────────────────────────────────────────────────────

model PipelineStage {
  id             String  @id @default(cuid())
  organizationId String
  key            String
  name           String
  color          String  @default("#2563EB")
  sortOrder      Int     @default(0)
  isWon          Boolean @default(false)
  isLost         Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Lead {
  id             String   @id @default(cuid())
  organizationId String
  stageId        String
  clientId       String?
  serviceId      String?
  assignedToId   String?
  name           String
  phone          String?
  email          String?
  source         String?
  valueCents     Int      @default(0)
  note           String?
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignedTo   Employee?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId, stageId])
}

// ─── Сповіщення та нагадування ───────────────────────────────────────────────

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CANCELLED
  APPOINTMENT_REMINDER
  CLIENT_CREATED
  PAYMENT_RECEIVED
  SYSTEM
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  type           NotificationType @default(SYSTEM)
  title          String
  body           String?
  entityType     String?
  entityId       String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, readAt])
}

enum ReminderChannel {
  IN_APP
  EMAIL
  TELEGRAM
  SMS
  WHATSAPP
}

enum ReminderStatus {
  PENDING
  /// Задачу забрав воркер. Проміжний стан, щоб два одночасні запуски
  /// планувальника не надіслали клієнту одне нагадування двічі.
  SENDING
  SENT
  FAILED
  CANCELLED
}

/// Черга нагадувань. Один запис = одне повідомлення в один канал.
/// Воркер (наступний етап) забирає PENDING зі scheduledFor <= now.
model ReminderJob {
  id             String          @id @default(cuid())
  organizationId String
  appointmentId  String
  channel        ReminderChannel @default(IN_APP)
  status         ReminderStatus  @default(PENDING)
  scheduledFor   DateTime
  sentAt         DateTime?
  attempts       Int             @default(0)
  error          String?
  payload        Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([appointmentId])
}

/// Стан ЗАПИТУ відгуку — того, як ми його просимо.
/// Наявність самої оцінки описується полем `rating`, а не цим статусом:
/// надісланий лист і отримана відповідь — різні речі, і плутати їх в одному
/// полі означає рано чи пізно втратити одне з них.
enum ReviewRequestStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

/// Відгук про візит.
///
/// Один візит — один відгук (`appointmentId` унікальний). Питаємо через
/// `reviewDelayHours` годин після візиту, поки враження свіже.
///
/// ВАЖЛИВО про те, чого тут НЕМАЄ: відбору за оцінкою. Схема «п'ять зірок
/// веду на Google, менше — ховаю» називається review gating і прямо
/// заборонена правилами Google: за неї площадка може зняти бізнесу всі
/// відгуки одразу. Тож посилання на публічну площадку бачать усі, а
/// низька оцінка лише додає крок «розкажіть, що сталося» — щоб людину
/// спершу вислухали ми.
model Review {
  id             String              @id @default(cuid())
  organizationId String
  appointmentId  String              @unique
  clientId       String
  employeeId     String?

  /// Посилання з листа. У базі — лише хеш: лист живе в чужій поштовій
  /// скриньці, і витік бекапу не має відкривати чужі відгуки.
  tokenHash String              @unique
  status    ReviewRequestStatus @default(PENDING)
  /// Коли просити. Не раніше — інакше запитаємо в момент візиту.
  sendAfter DateTime
  /// Коли попросили. Порожнє — лист ще не пішов.
  requestedAt DateTime?
  /// Після цієї дати посилання не працює.
  expiresAt   DateTime
  attempts    Int       @default(0)
  error       String?

  /// 1..5. Порожнє — клієнт ще не відповів.
  rating      Int?
  comment     String?
  submittedAt DateTime?

  /// Чи показувати відгук на публічній сторінці салону.
  /// Вирішує салон, не клієнт: інакше публічна сторінка стає
  /// некерованою стрічкою.
  isPublic  Boolean   @default(false)
  replyText String?
  repliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([organizationId, submittedAt])
  @@index([organizationId, rating])
  @@index([status, sendAfter])
}

// ─── Аудит ───────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  meta           Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}
