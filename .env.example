# ─────────────────────────────────────────────────────────────
# crm.factory — environment variables
# Скопіюйте цей файл у `.env` та заповніть значення.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (обов'язково).
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://crmfactory:crmfactory@127.0.0.1:5432/crmfactory?schema=public"

# Пряме підключення для міграцій, в обхід пулера.
#
# Neon і Supabase дають ДВІ адреси на ту саму базу: через пулер (у хості
# є `-pooler`, у Supabase — порт 6543) і пряму. Застосунку потрібен пулер,
# інакше серверлес-виклики вичерпають ліміт з'єднань. Але пулер працює
# в transaction-режимі й не пропускає частину DDL, тож `prisma migrate
# deploy` через нього мовчки зупиняється.
#
# Тому: DATABASE_URL — через пулер, DIRECT_URL — пряма адреса.
# Локально пулера немає, і обидві змінні просто однакові.
DIRECT_URL="postgresql://crmfactory:пароль@127.0.0.1:5432/crmfactory?schema=public"

# Секрет для підпису session-cookie (JWT, HS256).
# Згенеруйте власний: `openssl rand -base64 48`
# Мінімум 32 символи. НІКОЛИ не комітьте реальне значення.
AUTH_SECRET="change-me-please-generate-a-long-random-secret-value-32b+"

# Публічний базовий URL — використовується для booking-посилань і QR-кодів.
# У продакшні обов'язково змініть на реальний домен, інакше посилання на
# сторінку запису вестимуть на localhost. Значення вшивається у збірку —
# після зміни потрібен повторний деплой.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Порт HTTP-сервера — ТІЛЬКИ для локального запуску.
# На Vercel цю змінну задавати НЕ ТРЕБА: платформа керує портом сама.
# На Railway / Render / Fly вона теж підставляється автоматично.
PORT=3001

# Email супер-адміністратора платформи (доступ до /admin).
# Користувач із цим email отримує роль SUPER_ADMIN під час seed.
SUPER_ADMIN_EMAIL="admin@crm.factory"

# Ключ аварійного відновлення доступу супер-адміна.
# Відкриває сторінку /recovery, де можна задати новий пароль акаунту з
# SUPER_ADMIN_EMAIL, не маючи налаштованої пошти. Знати ключ може лише той,
# хто має доступ до змінних середовища на хостингу.
# Згенеруйте власний: `openssl rand -base64 32`
# Якщо змінна не задана — сторінка /recovery недоступна.
ADMIN_RECOVERY_KEY=""

# ── Пошта (відновлення пароля, сповіщення) ────────────────────────────────
# Без RESEND_API_KEY листи не відправляються, а друкуються в лог сервера
# (Vercel → Logs). Для реальних клієнтів ключ обов'язковий.
# RESEND_API_KEY=""
# MAIL_FROM="crm.factory <noreply@ваш-домен.com>"

# ── Розсилка нагадувань ───────────────────────────────────────────────────
# Захищає ендпоінт GET /api/cron/reminders, який розсилає нагадування про
# записи. Без цієї змінної ендпоінт відповідає 503 і розсилки НЕ буде:
# відкритий ендпоінт, що шле листи, — це чужа розсилка за ваш рахунок.
#
# Згенерувати:  openssl rand -hex 32
# Той самий рядок треба покласти в секрети GitHub Actions (CRON_SECRET),
# бо саме воркфлоу .github/workflows/reminders.yml смикає ендпоінт.
# CRON_SECRET=""

# ── factory AI ─────────────────────────────────────────────────────────────
# Вмикає вбудованого асистента, який відповідає на питання про бізнес.
# Ключ видається в консолі Anthropic. Без нього асистент вимкнений і
# пояснює це в інтерфейсі. Кожен запит тарифікується — у застосунку
# стоїть ліміт 30 запитів на годину на організацію.
# ANTHROPIC_API_KEY=""
#
# Модель асистента. За замовчуванням claude-opus-5 — найточніша, але для
# цієї задачі надлишкова: цифри рахує Postgres, а моделі лишається їх
# пояснити. Дешевші варіанти (ціна за млн токенів вхід/вихід):
#   claude-sonnet-5   $2 / $10
#   claude-haiku-4-5  $1 / $5
# ANTHROPIC_MODEL="claude-haiku-4-5"

# ── Опційно: інші провайдери нагадувань (архітектура готова)
# TELEGRAM_BOT_TOKEN=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
# WHATSAPP_TOKEN=""

# ── Опційно: онлайн-оплата (Stripe)
#
# Без цих ключів застосунок повністю працює: тарифи діють, але оформити
# підписку карткою не можна — план активується вручну з /admin.
#
# Як підключити:
#  1. У Stripe Dashboard створіть Product і три recurring-ціни в EUR:
#     Starter €14/міс, Business €29/міс, Pro €59/міс.
#  2. Скопіюйте сюди id кожної ціни (починаються з `price_`).
#  3. Додайте вебхук на https://ВАШ-ДОМЕН/api/webhooks/stripe
#     з подіями: checkout.session.completed,
#     customer.subscription.created / updated / deleted
#  4. Секрет підпису вебхука (`whsec_...`) — у STRIPE_WEBHOOK_SECRET.
#
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_STARTER="price_..."
# STRIPE_PRICE_BUSINESS="price_..."
# STRIPE_PRICE_PRO="price_..."
