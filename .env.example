# ─────────────────────────────────────────────────────────────
# crm.factory — environment variables
# Скопіюйте цей файл у `.env` та заповніть значення.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (обов'язково).
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://crmfactory:crmfactory@127.0.0.1:5432/crmfactory?schema=public"

# Секрет для підпису session-cookie (JWT, HS256).
# Згенеруйте власний: `openssl rand -base64 48`
# Мінімум 32 символи. НІКОЛИ не комітьте реальне значення.
AUTH_SECRET="change-me-please-generate-a-long-random-secret-value-32b+"

# Публічний базовий URL — використовується для booking-посилань і QR-кодів.
# У продакшні обов'язково змініть на реальний домен, інакше посилання на
# сторінку запису вестимуть на localhost. Значення вшивається у збірку —
# після зміни потрібен повторний деплой.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Порт HTTP-сервера — ТІЛЬКИ для локального запуску.
# На Vercel цю змінну задавати НЕ ТРЕБА: платформа керує портом сама.
# На Railway / Render / Fly вона теж підставляється автоматично.
PORT=3001

# Email супер-адміністратора платформи (доступ до /admin).
# Користувач із цим email отримує роль SUPER_ADMIN під час seed.
SUPER_ADMIN_EMAIL="admin@crm.factory"

# ── Опційно: провайдери нагадувань (архітектура готова, інтеграції — наступний етап)
# RESEND_API_KEY=""
# TELEGRAM_BOT_TOKEN=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
# WHATSAPP_TOKEN=""

# ── Опційно: онлайн-оплата (Stripe)
#
# Без цих ключів застосунок повністю працює: тарифи діють, але оформити
# підписку карткою не можна — план активується вручну з /admin.
#
# Як підключити:
#  1. У Stripe Dashboard створіть Product і три recurring-ціни в EUR:
#     Starter €14/міс, Business €29/міс, Pro €59/міс.
#  2. Скопіюйте сюди id кожної ціни (починаються з `price_`).
#  3. Додайте вебхук на https://ВАШ-ДОМЕН/api/webhooks/stripe
#     з подіями: checkout.session.completed,
#     customer.subscription.created / updated / deleted
#  4. Секрет підпису вебхука (`whsec_...`) — у STRIPE_WEBHOOK_SECRET.
#
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_STARTER="price_..."
# STRIPE_PRICE_BUSINESS="price_..."
# STRIPE_PRICE_PRO="price_..."
