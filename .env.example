# ─────────────────────────────────────────────────────────────
# crm.factory — environment variables
# Скопіюйте цей файл у `.env` та заповніть значення.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (обов'язково).
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://crmfactory:crmfactory@127.0.0.1:5432/crmfactory?schema=public"

# Секрет для підпису session-cookie (JWT, HS256).
# Згенеруйте власний: `openssl rand -base64 48`
# Мінімум 32 символи. НІКОЛИ не комітьте реальне значення.
AUTH_SECRET="change-me-please-generate-a-long-random-secret-value-32b+"

# Публічний базовий URL — використовується для booking-посилань і QR-кодів.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Email супер-адміністратора платформи (доступ до /admin).
# Користувач із цим email отримує роль SUPER_ADMIN під час seed.
SUPER_ADMIN_EMAIL="admin@crm.factory"

# ── Опційно: провайдери нагадувань (архітектура готова, інтеграції — наступний етап)
# RESEND_API_KEY=""
# TELEGRAM_BOT_TOKEN=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
# WHATSAPP_TOKEN=""

# ── Опційно: білінг (Stripe). Архітектура підготовлена, ключі не обов'язкові.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
